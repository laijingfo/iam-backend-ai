        </foreach>
    </select>

    <!--发送失败页面统计待发送邮件数量:发送邮件之前统计lm和bpo的数量:邮件数量(lm+bpo)(全选)-->
    <select id="getBpoAndLineManagerCountByDistinctForFailedSend" resultType="java.util.Map">
        SELECT COUNT(DISTINCT bpo) as bpoCount,COUNT(DISTINCT line_manager) as lineManagerCount
        FROM user_access_review WHERE 1=1
        AND overall_send_status = 'Failed'
        AND delete_flag = false
        AND (COALESCE(bpo_review_status, '') != '2' OR COALESCE(line_manager_review_status, '') != '2')
        AND (COALESCE(bpo_band_ed_flag, '') != '1' OR COALESCE(line_manager_band_ed_flag, '') != '1')
        <!--<if test="bean.cmdbId != null and bean.cmdbId != ''">
            AND cmdb_id = #{bean.cmdbId}
        </if>
        <if test="bean.appName != null and bean.appName != ''">
            AND app_name = #{bean.appName}
        </if>-->
        <if test="bean.itCodeOfUser != null and bean.itCodeOfUser != ''">
            AND it_code_of_user = #{bean.itCodeOfUser}
        </if>
        <if test="bean.lineManager != null and bean.lineManager != ''">
            AND line_manager = #{bean.lineManager}
        </if>
        <if test="bean.lineManagerLevelCode != null and bean.lineManagerLevelCode != ''">
            AND line_manager_level_code = #{bean.lineManagerLevelCode}
        </if>
        <if test="bean.dept != null and bean.dept != ''">
            AND dept = #{bean.dept}
        </if>
        <if test="bean.lineManagerReviewStatus != null and bean.lineManagerReviewStatus != ''">
            AND line_manager_review_status = #{bean.lineManagerReviewStatus}
        </if>
        <if test="bean.bpo != null and bean.bpo != ''">
            AND bpo = #{bean.bpo}
        </if>
        <if test="bean.bpoReviewStatus != null and bean.bpoReviewStatus != ''">
            AND bpo_review_status = #{bean.bpoReviewStatus}
        </if>
        <if test="bean.cmdbIdListOfChoose != null and bean.cmdbIdListOfChoose != ''">
            AND cmdb_id IN
            <foreach collection="bean.cmdbIdListOfChoose" item="type" open="(" separator="," close=")">
                #{type}
            </foreach>
        </if>
        <if test="bean.appNameListOfChoose != null and bean.appNameListOfChoose != ''">
            AND app_name IN
            <foreach collection="bean.appNameListOfChoose" item="type" open="(" separator="," close=")">
                #{type}
            </foreach>
        </if>
        <choose >
            <when test='roleFlag == "2"'>
            </when>
            <when test='roleFlag == "3" and bean.cmdbIdList != null and bean.cmdbIdList.size() > 0'>
                AND cmdb_id IN
                <foreach collection="bean.cmdbIdList" item="seq" open="(" separator="," close=")">
                    #{seq}
                </foreach>
            </when>
            <otherwise>
