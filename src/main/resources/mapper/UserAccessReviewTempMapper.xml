        </foreach>
    </select>

    <!--统计待发送页面待发送邮件数量(单选)-->
    <select id="getLineManagerCountDistinctBySequenceNumbers" resultType="java.lang.Integer">
        SELECT COUNT(distinct line_manager) as lineManager_number
        FROM user_access_review
        WHERE 1=1
        AND overall_send_status = 'Pending'
