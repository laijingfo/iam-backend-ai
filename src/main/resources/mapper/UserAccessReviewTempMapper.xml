        </foreach>
    </select>
    <select id="getLineManagerCountDistinctBySequenceNumbersForFailedSendEmail" resultType="java.lang.Integer">
        SELECT COUNT(distinct line_manager) as lineManager_number
        FROM user_access_review
        WHERE 1=1
        AND overall_send_status = 'Failed'
