<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lenovo.mapper.WorkspaceMapper">

    <resultMap id="BaseResultMap" type="com.lenovo.entity.Workspace">
            <result property="id" column="id" jdbcType="INTEGER"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="creator" column="creator" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,name,description,
        creator,update_time,create_time
    </sql>
    <select id="queryByUser" resultType="com.lenovo.entity.Workspace">
        select a.*
        from workspace as a,
             sys_role as b,
             sys_user_roles as c
        where a.id = b.workspace_id
          and c.role_id = b.id
          and (c.user_id = #{user} or a.creator = #{user})
    </select>
</mapper>
