        <!--
            Legacy SAML compatibility boundary

            lenovo-samlsp:1.0.0 was compiled against OpenSAML 3.1.0 but its
            published POM does not expose the required transitive dependencies.
            These OpenSAML modules therefore have to remain explicitly declared.
            Do not upgrade OpenSAML independently: lenovo-samlsp uses OpenSAML 3
            binary APIs (including Joda-Time signatures).

            Security-sensitive transitive dependency replacements are declared
            after the OpenSAML modules below:
              OpenSAML 3.1.0 -> xmlsec 2.0.3       -> overridden by 2.3.5
              OpenSAML 3.1.0 -> cryptacular 1.0   -> overridden by 1.1.4
              OpenSAML/Cryptacular -> bcprov-jdk15on -> excluded and replaced
                                                       by bcprov-jdk18on 1.85.2
            Velocity 1.7 is intentionally retained because OpenSAML 3 uses its
            1.x API and the 2.x line has different coordinates and behavior.
        -->
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-core</artifactId>
            <version>${opensaml.version}</version>
        </dependency>
        <!-- OpenSAML 3.1 runtime requires com.google.common.base.Function. -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-saml-api</artifactId>
            <version>${opensaml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-saml-impl</artifactId>
            <version>${opensaml.version}</version>
            <exclusions>
                <exclusion>
                    <artifactId>commons-collections</artifactId>
                    <groupId>commons-collections</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-messaging-api</artifactId>
            <version>${opensaml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-xmlsec-api</artifactId>
            <version>${opensaml.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk15on</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-xmlsec-impl</artifactId>
            <version>${opensaml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-messaging-impl</artifactId>
            <version>${opensaml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-soap-api</artifactId>
            <version>${opensaml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-soap-impl</artifactId>
            <version>${opensaml.version}</version>
        </dependency>
        <dependency>
            <groupId>org.opensaml</groupId>
            <artifactId>opensaml-security-impl</artifactId>
            <version>${opensaml.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk15on</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            Replace the vulnerable bcprov-jdk15on versions brought by both
            OpenSAML and Cryptacular. Keep every bcprov-jdk15on exclusion above
            and below; allowing both artifact lines packages duplicate
            org.bouncycastle.* classes and makes runtime class selection unsafe.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85.2</version>
        </dependency>

        <!-- Same coordinate as OpenSAML's xmlsec 2.0.3; direct dependency wins. -->
        <dependency>
            <groupId>org.apache.santuario</groupId>
            <artifactId>xmlsec</artifactId>
            <version>2.3.5</version>
        </dependency>

        <!--
            Cryptacular 1.1.4 fixes CVE-2020-7226 while staying on the legacy
            OpenSAML-compatible API line. It normally brings bcprov-jdk15on
            1.59, so that transitive provider must also be excluded.
        -->
        <dependency>
            <groupId>org.cryptacular</groupId>
            <artifactId>cryptacular</artifactId>
            <version>1.1.4</version>
            <exclusions>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk15on</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

